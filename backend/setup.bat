@echo off
REM =====================================================
REM اسکریپت راه‌اندازی پروژه بیمارستان - ویندوز
REM =====================================================

echo.
echo ==========================================
echo   راه اندازی پروژه بیمارستان
echo ==========================================
echo.

REM =====================================================
REM ۱. بررسی نصب پایتون
REM =====================================================
python --version >nul 2>&1
if errorlevel 1 (
    echo [خطا] پایتون نصب نیست یا در PATH نیست.
    echo لطفاً Python 3.12 از python.org نصب کنید.
    pause
    exit /b 1
)

echo [OK] پایتون نصب است.
python --version

REM =====================================================
REM ۲. ساخت محیط مجازی
REM =====================================================
if not exist "myenv" (
    echo.
    echo [1/6] ساخت محیط مجازی...
    python -m venv myenv
) else (
    echo.
    echo [1/6] محیط مجازی از قبل موجود است.
)

REM =====================================================
REM ۳. فعال سازی محیط مجازی
REM =====================================================
echo.
echo [2/6] فعال سازی محیط مجازی...
call myenv\Scripts\activate.bat

REM =====================================================
REM ۴. نصب پکیج ها
REM =====================================================
echo.
echo [3/6] به روزرسانی pip...
python -m pip install --upgrade pip

echo.
echo [4/6] نصب پکیج ها (ممکن است چند دقیقه طول بکشد)...
pip install -r requirements.txt

REM =====================================================
REM ۵. ساخت فایل .env
REM =====================================================
echo.
echo [5/6] بررسی فایل .env...
if not exist ".env" (
    if exist ".env.example" (
        copy .env.example .env
        echo [هشدار] فایل .env ساخته شد. لطفاً SECRET_KEY را تغییر دهید.
    )
)

REM =====================================================
REM ۶. Migration
REM =====================================================
echo.
echo [6/6] اجرای migration...
python manage.py makemigrations
python manage.py migrate

REM =====================================================
REM پیام نهایی
REM =====================================================
echo.
echo ==========================================
echo   راه اندازی با موفقیت انجام شد!
echo ==========================================
echo.
echo برای ساخت ادمین:
echo   myenv\Scripts\activate
echo   python manage.py createsuperuser
echo.
echo برای اجرای سرور:
echo   myenv\Scripts\activate
echo   python manage.py runserver
echo.
pause